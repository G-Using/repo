name: Build and Deploy to Cydia Repo

on:
  push:
    branches:
      - main
      - master

jobs:
  build-and-deploy:
    runs-on: macos-13

    steps:
      - name: 检出插件源码
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: 配置 Theos 环境
        run: |
          git clone --recursive https://github.com/theos/theos.git $HOME/theos
          echo "THEOS=$HOME/theos" >> $GITHUB_ENV

      - name: 下载 iOS SDK
        run: |
          git clone --quiet https://github.com/theos/sdks.git $HOME/theos/sdks

      - name: 编译并打包插件
        run: |
          make clean
          make package FINALPACKAGE=1

      - name: 推送 deb 并刷新越狱源
        env:
          GH_TOKEN: ${{ secrets.REPO_DEPLOY_KEY }}
          REPO_TARGET: "g-using/repo"
        run: |
          # 查找生成的 deb 包
          DEB_FILE=$(ls packages/*.deb | head -n 1)
          if [ -z "$DEB_FILE" ]; then
            echo "未找到编译生成的 deb 包！"
            exit 1
          fi

          # 克隆你的越狱源仓库
          git clone https://x-access-token:${GH_TOKEN}@github.com/${REPO_TARGET}.git repo_target
          
          # 确保 debs 目录存在并放入新包
          mkdir -p repo_target/debs
          cp "$DEB_FILE" repo_target/debs/

          cd repo_target

          # 安装 dpkg 扫描工具生成源索引
          brew install dpkg
          dpkg-scanpackages -m ./debs > Packages
          bzip2 -fks Packages
          gzip -fk Packages

          # 提交更改并推送回源仓库
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Auto release from Actions" || exit 0
          git push origin main || git push origin master
